  {
   "id": "metier-conflits-chef",
   "st": 0,
   "title": "La couleur n’est pas bonne",
   "who": "组长",
   "whoFr": "Chef d’équipe",
   "intro": "Ton chef d’équipe arrive, fâché, avec une paire de chaussures à la main.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "这些鞋的颜色不对！你怎么做的？",
     "p": "Zhèxiē xié de yánsè bú duì! Nǐ zěnme zuò de?",
     "fr": "La couleur de ces chaussures n’est pas bonne ! Tu as fait comment ?",
     "o": [
      {
       "h": "对不起，这是误会。你听我解释。",
       "p": "Duìbuqǐ, zhè shì wùhuì. Nǐ tīng wǒ jiěshì.",
       "fr": "Pardon, c’est un malentendu. Laisse-moi t’expliquer.",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "不是我的错！",
       "p": "Bú shì wǒ de cuò!",
       "fr": "Ce n’est pas ma faute !",
       "fix": "Te défendre en criant énerve le chef. Commence calmement : « 对不起，这是误会。你听我解释 »."
      }
     ]
    },
    "b": {
     "h": "好，你说。",
     "p": "Hǎo, nǐ shuō.",
     "fr": "D’accord, vas-y.",
     "o": [
      {
       "h": "早上我听错了，以为是白色。",
       "p": "Zǎoshang wǒ tīng cuò le, yǐwéi shì báisè.",
       "fr": "Ce matin j’ai mal entendu, j’ai cru que c’était blanc.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "你说得不清楚！",
       "p": "Nǐ shuō de bù qīngchu!",
       "fr": "Tu ne parles pas clairement !",
       "fix": "Accuser le chef lui fait perdre la face (面子). Dis plutôt « 我听错了 » : tu restes polie, et lui aussi."
      }
     ]
    },
    "c": {
     "h": "那现在怎么办？",
     "p": "Nà xiànzài zěnme bàn?",
     "fr": "Alors, on fait comment maintenant ?",
     "o": [
      {
       "h": "我有一个办法：今天加班，重新做。",
       "p": "Wǒ yǒu yí ge bànfǎ: jīntiān jiābān, chóngxīn zuò.",
       "fr": "J’ai une solution : je fais des heures sup aujourd’hui et je refais.",
       "ok": 1,
       "n": "d"
      },
      {
       "h": "我不知道。",
       "p": "Wǒ bù zhīdào.",
       "fr": "Je ne sais pas.",
       "fix": "Montre que tu veux régler le problème : « 我有一个办法… » et propose quelque chose."
      }
     ]
    },
    "d": {
     "h": "好吧。下次要注意。",
     "p": "Hǎo ba. Xià cì yào zhùyì.",
     "fr": "Bon. La prochaine fois, fais attention.",
     "o": [
      {
       "h": "好的，下次我会注意。谢谢你的理解。",
       "p": "Hǎo de, xià cì wǒ huì zhùyì. Xièxie nǐ de lǐjiě.",
       "fr": "D’accord, je ferai attention. Merci de ta compréhension.",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "没有下次。",
       "p": "Méiyǒu xià cì.",
       "fr": "Il n’y aura pas de prochaine fois.",
       "fix": "Ça sonne insolent. Termine en douceur : « 下次我会注意。谢谢你的理解 »."
      }
     ]
    },
    "end": {
     "h": "没关系，加油！",
     "p": "Méi guānxi, jiāyóu!",
     "fr": "Ce n’est pas grave, courage !",
     "end": 1
    }
