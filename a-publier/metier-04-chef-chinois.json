   "id": "metier-chef-conge",
   "st": 0,
   "title": "Demander un jour de congé",
   "who": "经理",
   "whoFr": "Directeur",
   "intro": "Ton frère se marie vendredi au village. Tu vas voir le directeur pour demander un jour de congé.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "{name}，有什么事？",
     "p": "{name}, yǒu shénme shì?",
     "fr": "{name}, qu’est-ce qu’il y a ?",
     "o": [
      {
       "h": "经理，不好意思，我想请一天假。",
       "p": "Jīnglǐ, bù hǎoyìsi, wǒ xiǎng qǐng yì tiān jià.",
       "fr": "Monsieur le directeur, excusez-moi, je voudrais un jour de congé.",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "我明天不来。",
       "p": "Wǒ míngtiān bù lái.",
       "fr": "Demain, je ne viens pas.",
       "fix": "Trop direct : on ne prévient pas, on demande. Dis « 不好意思，我想请一天假 »."
      }
     ]
    },
    "b": {
     "h": "为什么？这个星期很忙。",
     "p": "Wèishénme? Zhège xīngqī hěn máng.",
     "fr": "Pourquoi ? Cette semaine, on a beaucoup de travail.",
     "o": [
      {
       "h": "家里有事。今天我会多做一点。",
       "p": "Jiāli yǒu shì. Jīntiān wǒ huì duō zuò yìdiǎn.",
       "fr": "Une affaire de famille. Aujourd’hui, j’en ferai un peu plus.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "这不是你的事。",
       "p": "Zhè bú shì nǐ de shì.",
       "fr": "Ça ne te regarde pas.",
       "fix": "Ça le vexe et il perd la face. Donne une raison courte et polie : « 家里有事 »."
      }
     ]
    },
    "c": {
     "h": "好吧，我批准。那星期六你能来加班吗？",
     "p": "Hǎo ba, wǒ pīzhǔn. Nà xīngqīliù nǐ néng lái jiābān ma?",
     "fr": "Bon, j’accepte. Et samedi, tu peux venir faire des heures sup ?",
     "o": [
      {
       "h": "星期六恐怕不行，不好意思。下次我一定来。",
       "p": "Xīngqīliù kǒngpà bù xíng, bù hǎoyìsi. Xià cì wǒ yídìng lái.",
       "fr": "Samedi, j’ai bien peur que non, désolée. La prochaine fois, je viendrai sans faute.",
       "ok": 1,
       "n": "d"
      },
      {
       "h": "不要！",
       "p": "Bú yào!",
       "fr": "Non !",
       "fix": "Un « non » sec fait perdre la face au chef. Dis « 恐怕不行 », excuse-toi et propose une autre fois."
      }
     ]
    },
    "d": {
     "h": "没关系。路上小心。",
     "p": "Méi guānxi. Lùshang xiǎoxīn.",
     "fr": "Pas de souci. Fais attention sur la route.",
     "o": [
      {
       "h": "谢谢经理！您先忙。",
       "p": "Xièxie jīnglǐ! Nín xiān máng.",
       "fr": "Merci, monsieur le directeur ! Je vous laisse travailler.",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "我知道。",
       "p": "Wǒ zhīdào.",
       "fr": "Je sais.",
       "fix": "Un peu sec. Remercie : « 谢谢经理！ » Ça entretient une bonne relation."
      }
     ]
    },
    "end": {
     "h": "不客气。好好休息。",
     "p": "Bú kèqi. Hǎohǎo xiūxi.",
     "fr": "De rien. Repose-toi bien.",
     "end": 1
    }
   }
