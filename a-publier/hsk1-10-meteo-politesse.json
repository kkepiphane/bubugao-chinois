   "intro": "Il fait très chaud dans l’atelier. Une collègue engage la conversation.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "今天天气怎么样？",
     "p": "Jīntiān tiānqì zěnmeyàng?",
     "fr": "Quel temps fait-il aujourd’hui ?",
     "o": [
      {
       "h": "今天很热。",
       "p": "Jīntiān hěn rè.",
       "fr": "Il fait très chaud.",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "今天星期五。",
       "p": "Jīntiān xīngqīwǔ.",
       "fr": "Aujourd’hui c’est vendredi.",
       "fix": "天气 = le temps qu’il fait : « 很热 » (chaud), « 很冷 » (froid)."
      }
     ]
    },
    "b": {
     "h": "北京很冷，下雨了。你喜欢下雨吗？",
     "p": "Běijīng hěn lěng, xià yǔ le. Nǐ xǐhuan xià yǔ ma?",
     "fr": "À Pékin il fait froid, il pleut. Tu aimes la pluie ?",
     "o": [
      {
       "h": "不喜欢。你呢？",
       "p": "Bù xǐhuan. Nǐ ne?",
       "fr": "Non. Et toi ?",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "喜欢！",
       "p": "Xǐhuan!",
       "fr": "Oui, j’aime !",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "我是下雨。",
       "p": "Wǒ shì xià yǔ.",
       "fr": "(phrase incorrecte)",
       "fix": "Réponds avec 喜欢 (j’aime) ou 不喜欢 (je n’aime pas)."
      }
     ]
    },
    "end": {
     "h": "哈哈，好的！",
     "p": "Hāhā, hǎo de!",
     "fr": "Haha, d’accord !",
     "end": 1
    }
   }
  }
