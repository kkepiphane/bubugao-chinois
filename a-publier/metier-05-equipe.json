       "n": "c"
      },
      {
       "h": "五百块。",
       "p": "Wǔbǎi kuài.",
       "fr": "Cinq cents francs.",
       "fix": "块 = de l’argent. Pour des chaussures, on compte en paires : « 五百双 »."
      }
     ]
    },
    "c": {
     "h": "小王今天没来。",
     "p": "Xiǎo Wáng jīntiān méi lái.",
     "fr": "Xiao Wang n’est pas venu aujourd’hui.",
     "o": [
      {
       "h": "他今天请假了。我们一起完成目标。",
       "p": "Tā jīntiān qǐngjià le. Wǒmen yìqǐ wánchéng mùbiāo.",
       "fr": "Il est en congé aujourd’hui. On atteint l’objectif ensemble.",
       "ok": 1,
       "n": "d"
      },
      {
       "h": "那我们不做了。",
       "p": "Nà wǒmen bú zuò le.",
       "fr": "Alors on arrête.",
       "fix": "Une absence, ça s’organise ! Rassure l’équipe : « 我们一起完成目标 »."
      }
     ]
    },
    "d": {
     "h": "做完了！五百双。",
     "p": "Zuò wán le! Wǔbǎi shuāng.",
     "fr": "Fini ! Cinq cents paires.",
     "o": [
      {
       "h": "做得很好！你们辛苦了。",
       "p": "Zuò de hěn hǎo! Nǐmen xīnkǔ le.",
       "fr": "Très bien fait ! Merci pour votre travail.",
       "ok": 1,
       "n": "end"
      },
