       "n": "b"
      },
      {
       "h": "你又迟到了！你太差了！",
       "p": "Nǐ yòu chídào le! Nǐ tài chà le!",
       "fr": "Encore en retard ! Tu es vraiment nul !",
       "fix": "Le gronder devant tout le monde lui fait perdre la face. Reste ferme mais calme : « 下次注意就好 »."
      }
     ]
    },
    "b": {
     "h": "好的。今天要做多少双？",
     "p": "Hǎo de. Jīntiān yào zuò duōshao shuāng?",
     "fr": "D’accord. On doit faire combien de paires aujourd’hui ?",
     "o": [
