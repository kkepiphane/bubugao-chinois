 "convs": [
  {
   "id": "transport",
   "st": 0,
   "title": "En taxi dans une ville chinoise",
   "who": "司机",
   "whoFr": "Chauffeur de taxi",
   "intro": "Tu es en voyage en Chine. Tu montes dans un taxi pour aller à la gare.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "你好，去哪儿？",
     "p": "Nǐ hǎo, qù nǎr?",
     "fr": "Bonjour, on va où ?",
     "o": [
      {
       "h": "师傅，去火车站。",
       "p": "Shīfu, qù huǒchēzhàn.",
       "fr": "Chef, à la gare, s’il vous plaît.",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "我在这儿。",
       "p": "Wǒ zài zhèr.",
       "fr": "Je suis ici.",
       "fix": "Il demande où tu vas : réponds « 去… » + le lieu, par exemple « 去火车站 »."
      }
     ]
    },
    "b": {
     "h": "前面堵车，我们右拐，好吗？",
     "p": "Qiánmiàn dǔchē, wǒmen yòu guǎi, hǎo ma?",
     "fr": "Ça bouchonne devant, on tourne à droite, d’accord ?",
     "o": [
      {
       "h": "好，没问题。",
       "p": "Hǎo, méi wèntí.",
       "fr": "D’accord, pas de problème.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "我要下车。",
       "p": "Wǒ yào xià chē.",
       "fr": "Je veux descendre.",
       "fix": "Pas besoin de descendre ! Il te propose un autre chemin : dis « 好，没问题 »."
      }
     ]
    },
    "c": {
     "h": "到了。在这儿停吗？",
     "p": "Dào le. Zài zhèr tíng ma?",
     "fr": "On est arrivés. Je m’arrête ici ?",
     "o": [
      {
       "h": "对，请在这儿停。多少钱？",
       "p": "Duì, qǐng zài zhèr tíng. Duōshao qián?",
       "fr": "Oui, arrêtez-vous ici. C’est combien ?",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "请这儿在停。",
       "p": "Qǐng zhèr zài tíng.",
       "fr": "(phrase mal construite)",
       "fix": "在 se met juste avant le lieu, puis vient le verbe : « 请在这儿停 »."
      }
     ]
    },
    "end": {
     "h": "三十块。谢谢！",
     "p": "Sānshí kuài. Xièxie!",
     "fr": "Trente yuans. Merci !",
     "end": 1
    }
   }
  }
