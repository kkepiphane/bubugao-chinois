 "convs": [
  {
   "id": "pharmacie",
   "st": 0,
   "title": "À la pharmacie",
   "who": "店员",
   "whoFr": "Pharmacienne",
   "intro": "Tu ne te sens pas bien. Tu vas à la pharmacie chinoise près de l’usine.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "你好，你哪儿不舒服？",
     "p": "Nǐ hǎo, nǐ nǎr bù shūfu?",
     "fr": "Bonjour, qu’est-ce qui ne va pas ?",
     "o": [
      {
       "h": "我头疼，也发烧了。",
       "p": "Wǒ tóu téng, yě fāshāo le.",
       "fr": "J’ai mal à la tête, et j’ai de la fièvre.",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "我很舒服。",
       "p": "Wǒ hěn shūfu.",
       "fr": "Je me sens très bien.",
       "fix": "舒服 = se sentir bien ! Dis « 我不舒服 », puis où tu as mal : « 我头疼 »."
      }
     ]
    },
    "b": {
     "h": "你咳嗽吗？",
     "p": "Nǐ késou ma?",
     "fr": "Tu tousses ?",
     "o": [
      {
       "h": "有一点儿咳嗽。",
       "p": "Yǒu yìdiǎnr késou.",
       "fr": "Je tousse un peu.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "不咳嗽。",
       "p": "Bù késou.",
       "fr": "Je ne tousse pas.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "我是咳嗽。",
       "p": "Wǒ shì késou.",
       "fr": "(phrase mal construite)",
       "fix": "Pas besoin de 是 ici : dis « 有一点儿咳嗽 » (un peu) ou « 不咳嗽 »."
      }
     ]
    },
    "c": {
     "h": "你感冒了。这个药一天三次，一次两片。",
     "p": "Nǐ gǎnmào le. Zhège yào yì tiān sān cì, yí cì liǎng piàn.",
     "fr": "Tu as un rhume. Ce médicament : trois fois par jour, deux comprimés à chaque fois.",
     "o": [
      {
       "h": "好的，饭前吃还是饭后吃？",
       "p": "Hǎo de, fàn qián chī háishi fàn hòu chī?",
       "fr": "D’accord. Avant ou après le repas ?",
       "ok": 1,
       "n": "d"
      },
      {
       "h": "一天两次，对吗？",
       "p": "Yì tiān liǎng cì, duì ma?",
       "fr": "Deux fois par jour, c’est ça ?",
       "fix": "Non : 一天三次 = trois fois par jour. 两片 = deux comprimés."
      }
     ]
    },
    "d": {
     "h": "饭后吃。多喝水，多休息。",
     "p": "Fàn hòu chī. Duō hē shuǐ, duō xiūxi.",
     "fr": "Après le repas. Bois beaucoup d’eau et repose-toi bien.",
     "o": [
      {
       "h": "谢谢！多少钱？",
       "p": "Xièxie! Duōshao qián?",
       "fr": "Merci ! C’est combien ?",
       "ok": 1,
       "n": "end"
      }
     ]
    },
    "end": {
     "h": "十五块。早日康复！",
     "p": "Shíwǔ kuài. Zǎorì kāngfù!",
     "fr": "Quinze yuans. Bon rétablissement !",
     "end": 1
    }
   }
  }
 ],
 "bonus": [
  {
   "h": "早日康复",
   "p": "zǎorì kāngfù",
   "fr": "Bon rétablissement !",
   "note": "À dire à une collègue malade : elle sera touchée que tu le dises en chinois."
  }
 ]
}