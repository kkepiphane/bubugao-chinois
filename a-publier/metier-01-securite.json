 "convs": [
  {
   "id": "metier-securite-blessure",
   "st": 0,
   "title": "Une collègue se blesse",
   "who": "组长",
   "whoFr": "Chef d’équipe",
   "intro": "Ta collègue Xiao Li vient de se blesser la main sur une machine. Tu cours prévenir le chef d’équipe.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "{name}，怎么了？",
     "p": "{name}, zěnme le?",
     "fr": "{name}, qu’est-ce qui se passe ?",
     "o": [
      {
       "h": "有人受伤了！",
       "p": "Yǒu rén shòu shāng le!",
       "fr": "Quelqu’un est blessé !",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "我不舒服。",
       "p": "Wǒ bù shūfu.",
       "fr": "Je ne me sens pas bien.",
       "fix": "C’est ta collègue qui est blessée : crie « 有人受伤了！ »."
      }
     ]
    },
    "b": {
     "h": "谁受伤了？在哪儿？",
     "p": "Shéi shòu shāng le? Zài nǎr?",
     "fr": "Qui est blessé ? Où ?",
     "o": [
      {
       "h": "小李，在三号机器。",
       "p": "Xiǎo Lǐ, zài sān hào jīqì.",
       "fr": "Xiao Li, à la machine numéro 3.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "我看见了。",
       "p": "Wǒ kànjiàn le.",
       "fr": "Je l’ai vu.",
       "fix": "Il demande qui et où : « 小李，在三号机器 »."
      }
     ]
    },
    "c": {
     "h": "她的手怎么样？",
     "p": "Tā de shǒu zěnmeyàng?",
     "fr": "Comment va sa main ?",
     "o": [
      {
       "h": "她的手流血了，快叫救护车！",
       "p": "Tā de shǒu liú xuè le, kuài jiào jiùhùchē!",
       "fr": "Sa main saigne, vite, appelle une ambulance !",
       "ok": 1,
       "n": "d"
      },
      {
       "h": "她的手很漂亮。",
       "p": "Tā de shǒu hěn piàoliang.",
       "fr": "Sa main est très jolie.",
       "fix": "Ce n’est pas le moment ! Dis « 她的手流血了 » (sa main saigne)."
      }
     ]
    },
    "d": {
     "h": "好，我马上打电话。机器关了吗？",
     "p": "Hǎo, wǒ mǎshàng dǎ diànhuà. Jīqì guān le ma?",
     "fr": "D’accord, j’appelle tout de suite. La machine est arrêtée ?",
     "o": [
      {
       "h": "关了，没有人碰。",
       "p": "Guān le, méiyǒu rén pèng.",
       "fr": "Elle est arrêtée, personne n’y touche.",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "没关，我们还要做鞋。",
       "p": "Méi guān, wǒmen hái yào zuò xié.",
       "fr": "Non, on doit encore faire des chaussures.",
       "fix": "La sécurité d’abord : on arrête la machine (arrêt d’urgence) et personne n’y touche. Puis réponds « 关了 »."
      }
     ]
    },
    "end": {
     "h": "谢谢你，{name}。你做得很好。",
     "p": "Xièxie nǐ, {name}. Nǐ zuò de hěn hǎo.",
     "fr": "Merci, {name}. Tu as très bien réagi.",
     "end": 1
    }
   }
  },
