 "convs": [
  {
   "id": "wechat",
   "st": 0,
   "title": "On s’ajoute sur WeChat ?",
   "who": "小陈",
   "whoFr": "Collègue",
   "intro": "Une collègue chinoise sympathique veut garder le contact avec toi.",
   "start": "a",
   "nodes": {
    "a": {
     "h": "{name}，我们加个微信吧！",
     "p": "{name}, wǒmen jiā ge Wēixìn ba!",
     "fr": "{name}, on s’ajoute sur WeChat ?",
     "o": [
      {
       "h": "好啊，我扫你。",
       "p": "Hǎo a, wǒ sǎo nǐ.",
       "fr": "Avec plaisir, je scanne ton code.",
       "ok": 1,
       "n": "b"
      },
      {
       "h": "我没有钱。",
       "p": "Wǒ méiyǒu qián.",
       "fr": "Je n’ai pas d’argent.",
       "fix": "Elle ne parle pas d’argent : 加微信 = s’ajouter sur WeChat. Dis « 好啊，我扫你 »."
      }
     ]
    },
    "b": {
     "h": "这是我的二维码。",
     "p": "Zhè shì wǒ de èrwéimǎ.",
     "fr": "Voilà mon QR code.",
     "o": [
      {
       "h": "好了，我加你了。",
       "p": "Hǎo le, wǒ jiā nǐ le.",
       "fr": "C’est bon, je t’ai ajoutée.",
       "ok": 1,
       "n": "c"
      },
      {
       "h": "二维码多少钱？",
       "p": "Èrwéimǎ duōshao qián?",
       "fr": "Il coûte combien, le QR code ?",
       "fix": "Le QR code est gratuit ! Scanne-le, puis dis « 我加你了 »."
      }
     ]
    },
    "c": {
     "h": "收到了！晚上我给你发消息。",
     "p": "Shōudào le! Wǎnshang wǒ gěi nǐ fā xiāoxi.",
     "fr": "Bien reçu ! Ce soir, je t’envoie un message.",
     "o": [
      {
       "h": "好的，也可以给我打电话。",
       "p": "Hǎo de, yě kěyǐ gěi wǒ dǎ diànhuà.",
       "fr": "D’accord, tu peux aussi m’appeler.",
       "ok": 1,
       "n": "end"
      },
      {
       "h": "好的，我发消息你。",
       "p": "Hǎo de, wǒ fā xiāoxi nǐ.",
       "fr": "(phrase mal construite)",
       "fix": "给 + la personne se met AVANT le verbe : « 我给你发消息 »."
      }
     ]
    },
    "end": {
     "h": "好，晚上见！",
     "p": "Hǎo, wǎnshang jiàn!",
     "fr": "D’accord, à ce soir !",
     "end": 1
    }
   }
  }
 ],
